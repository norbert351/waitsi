# Copy this file to .env and fill in the values. 
# NEVER commit real secrets — this is a template of names only.
#
# Required — the service refuses to boot without a database.
WAITSI_DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB
# Recommended on a Neon DB that hosts other apps — keeps every table in its
# own schema so it never collides with `public`.
WAITSI_DB_SCHEMA=waitsi

# Operator routes (/admin/campaigns, /admin/sweep). Set to lock them behind
# `Authorization: Bearer <token>`. Unset = open (and the API says so).
WAITSI_ADMIN_TOKEN=

# ---- x402 sponsor rail (Base Sepolia, chain 84532) ----
WAITSI_X402_RPC=https://base-sepolia.publicnode.com
WAITSI_X402_CHAIN_ID=84532
WAITSI_X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
WAITSI_X402_PAYTO=0x3360DA7D976D7ED5Fe79Ee8022f539fb9af8f7C2
WAITSI_X402_PRICE_ATOMIC=100000        # 0.1 USDC per top-up
WAITSI_X402_DECIMALS=6
WAITSI_X402_SCAN_BLOCKS=2000

# ---- VaultAnchor writer (Base Sepolia) ----
WAITSI_ANCHOR_RPC=https://base-sepolia.publicnode.com
WAITSI_ANCHOR_CHAIN_ID=84532
WAITSI_ANCHOR_ADDRESS=0xECC0962C3Bf3C3c3e8C92d9d5f5F960B759bB7BD
# The SIGNER private key. Never commit it; leave blank to run in honest
# `mode:"logging"` (local receipts) rather than a fake on-chain claim.
WAITSI_ANCHOR_PK=

# Optional behaviour
HOST=0.0.0.0
PORT=3120
WAITSI_STALL_SECONDS=300
WAITSI_TEST_FAUCET=0

# ---- Google OAuth sign-in (authorization-code flow, confidential client) ----
# Both required to enable "Continue with Google". Never commit the secret.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_SECRET
# Optional; defaults to <host>/auth/google/callback. Add the exact value you
# use to the app's Authorized redirect URIs in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://waitsi-j9qk.onrender.com/auth/google/callback